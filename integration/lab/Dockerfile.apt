ARG BASE_IMAGE=debian:13

FROM golang:1.27 AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -o /out/zabbix-agent2-plugin-package-updates ./cmd/agent && \
    cd /out && \
    sha256sum zabbix-agent2-plugin-package-updates > zabbix-agent2-plugin-package-updates.sha256

FROM ${BASE_IMAGE}

ARG AGENT_CONFIG=integration/lab/zabbix_agent2.conf

# Zabbix publishes a repository only for the distributions it builds for.
# Derivatives such as Linux Mint and interim Ubuntu releases are not among
# them, so their images leave ZABBIX_RELEASE_URL empty and take zabbix-agent2
# from the distribution's own archive, which is what an operator on such a
# host does. Testing that path matters: it is a different build of the agent
# from a different packager, loading the same plugin.
ARG ZABBIX_RELEASE_URL=

RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        coreutils \
        curl \
        passwd \
        util-linux; \
    if [ -n "$ZABBIX_RELEASE_URL" ]; then \
        curl -fsSL -o /tmp/zabbix-release.deb "$ZABBIX_RELEASE_URL"; \
        dpkg -i /tmp/zabbix-release.deb; \
        rm /tmp/zabbix-release.deb; \
        apt-get update; \
    fi; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends zabbix-agent2; \
    if ! getent group zabbix >/dev/null 2>&1; then \
        groupadd --system zabbix; \
    fi; \
    if ! id zabbix >/dev/null 2>&1; then \
        useradd --system --gid zabbix --home-dir /var/lib/zabbix \
            --no-create-home --shell /usr/sbin/nologin zabbix; \
    fi; \
    apt-get clean

ENV HOME=/var/lib/zabbix

COPY ${AGENT_CONFIG} /etc/zabbix/zabbix_agent2.conf
COPY configs/package-updates.conf /tmp/release/package-updates.conf
COPY install.sh /tmp/install.sh
COPY --from=builder /out/ /tmp/release/

RUN RELEASE_URL=file:///tmp/release \
        SKIP_SERVICE_RESTART=1 \
        /tmp/install.sh && \
    rm /tmp/install.sh && \
    rm -r /tmp/release

EXPOSE 10050

ENTRYPOINT ["/usr/sbin/zabbix_agent2", "-f", "-c", "/etc/zabbix/zabbix_agent2.conf"]
